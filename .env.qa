# Committed, non-production defaults for the reusable local QA environment.
# Put real AI provider credentials in `.env.qa.local` (gitignored), never here.

ANKILEET_PROFILE="qa"

TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
LOCAL_DB_PATH="packages/db/qa.db"

BETTER_AUTH_SECRET="ankileet-qa-only-better-auth-secret"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ANKILEET_DISABLE_SIGNUP="true"
ANKILEET_EXTENSION_ORIGINS=""

AI_KEY_ENCRYPTION_SECRET="ankileet-qa-only-ai-key-encryption-secret"

# Optional real provider configuration. Copy these names into `.env.qa.local`.
# ANKILEET_QA_AI_PROVIDER="openai"
# ANKILEET_QA_AI_MODEL="gpt-5-mini"
# ANKILEET_QA_AI_REASONING_MODE="fast"
# ANKILEET_QA_AI_API_KEY=""
