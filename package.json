{
  "name": "ankileet",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Personal LeetCode/CS spaced-repetition app with FSRS-6, AI MCQs, and a Chrome extension",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm db:migrate && pnpm --filter @ankileet/web dev",
    "dev:web": "pnpm db:migrate && pnpm --filter @ankileet/web dev",
    "dev:all": "pnpm db:migrate && pnpm --parallel --filter @ankileet/web --filter @ankileet/extension dev",
    "dev:ext": "pnpm --filter @ankileet/extension dev",
    "dev:qa": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs",
    "dev:qa:all": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --extension",
    "qa:reset": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --reset-only",
    "dev:demo": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --demo",
    "demo:reset": "node --env-file=.env.qa --env-file-if-exists=.env.qa.local scripts/qa-dev.mjs --demo --reset-only",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0 && pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "qa:provider-smoke": "pnpm --filter ./apps/web provider:smoke",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm -r typecheck && tsc -p tests/e2e/tsconfig.json",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm build && pnpm extension:check-manifest && pnpm audit --prod --audit-level=high --ignore-registry-errors",
    "extension:build:unpacked": "pnpm --filter @ankileet/extension build:unpacked",
    "extension:check-manifest": "node scripts/check-extension-manifest.mjs",
    "study-lists:import": "node scripts/study-list-import.mjs",
    "study-lists:import-carl": "node scripts/study-list-import-carl.mjs",
    "db:generate": "pnpm --filter @ankileet/db generate",
    "db:migrate": "pnpm --filter @ankileet/db migrate",
    "db:migrate:qa": "pnpm --filter @ankileet/db migrate:qa",
    "db:migrate:preview": "pnpm --filter @ankileet/db migrate:preview",
    "db:migrate:prod": "pnpm --filter @ankileet/db migrate:prod",
    "db:studio": "pnpm --filter @ankileet/db studio",
    "db:studio:qa": "pnpm --filter @ankileet/db studio:qa",
    "db:studio:preview": "pnpm --filter @ankileet/db studio:preview",
    "db:studio:prod": "pnpm --filter @ankileet/db studio:prod",
    "db:backup": "pnpm --filter @ankileet/db backup",
    "db:release": "pnpm db:backup && pnpm db:migrate:prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.290",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.11",
      "browserslist": "4.28.7",
      "jsondiffpatch": "0.7.2",
      "minimatch@10": "10.2.6",
      "postcss": "8.5.26",
      "sharp": "0.35.5",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2",
      "undici@7": "7.29.1",
      "vite@6": "6.4.4",
      "ws": "8.21.1"
    }
  }
}
